{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["es2020", "dom"],
    "types": ["cypress", "@testing-library/cypress", "node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}